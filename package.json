{
  "name": "menuqr-pro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma generate --schema=prisma/schema.control.prisma && prisma generate --schema=prisma/schema.tenant.prisma && next build",
    "start": "next start -p ${PORT:-3000} -H 0.0.0.0",
    "lint": "next lint",
    "prisma:control:generate": "prisma generate --schema=prisma/schema.control.prisma",
    "prisma:control:migrate": "prisma migrate dev --schema=prisma/schema.control.prisma",
    "prisma:control:deploy": "prisma migrate deploy --schema=prisma/schema.control.prisma",
    "prisma:tenant:generate": "prisma generate --schema=prisma/schema.tenant.prisma",
    "prisma:tenant:deploy": "prisma migrate deploy --schema=prisma/schema.tenant.prisma"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.28.0",
    "next": "14.2.35",
    "nodemailer": "^9.0.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
