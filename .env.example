# Base de datos global / administración
CONTROL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menuqr_control?schema=public"

# Base de datos inquilino / restaurante por defecto
TENANT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menuqr_tenant?schema=public"

# Credenciales de Administrador Global
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="super-secret-pass"

# Seguridad y Autenticación
JWT_SECRET="menuqr-pro-super-secret-key-12345"

# Pasarelas de Pago y Servicios Externos
PAYMENT_API_KEY="your-payment-api-key"
PAYMENT_SECRET_KEY="your-payment-secret-key"
SMARTFIELDS_API_KEY="your-smartfields-api-key"
NEXT_PUBLIC_PLAN_PRICE="5"

# Configuración de Conexión a la API Central (ubicame-api)
USE_CENTRAL_API="true"
API_URL="https://api.ubicame.cc"
VITE_API_URL="https://api.ubicame.cc"
NEXT_PUBLIC_API_URL="https://api.ubicame.cc"