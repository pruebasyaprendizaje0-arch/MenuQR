# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO - MENUQR PRO
# Copia este archivo a .env.local para desarrollo local
# Configura estos valores en el panel de Coolify para producción
# ============================================================

# Base de datos global / administración
CONTROL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menuqr_control?schema=public"

# Base de datos inquilino / restaurante por defecto
TENANT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/menuqr_tenant?schema=public"

# Base de datos unificada / producción (en Coolify usar hostname del contenedor 'postgres:5432')
DATABASE_URL="postgresql://postgres:password_segura@postgres:5432/menuqr_pro?schema=public"

# Credenciales de Administrador Global
SUPER_ADMIN_EMAIL="admin@tudominio.com"
SUPER_ADMIN_PASSWORD="clave-super-admin-segura-minimo-16-caracteres"

# Seguridad y Autenticación (Generar con: openssl rand -base64 48)
JWT_SECRET="reemplaza-con-clave-criptografica-generada-en-produccion"

# URL Pública de la Aplicación
APP_URL="https://menuqr.tudominio.com"

# Configuración del Servicio de Correos (Resend API o SMTP)
RESEND_API_KEY="re_placeholder_api_key_aqui"
RESEND_FROM="\"MenuQR Pro\" <onboarding@tudominio.com>"

SMTP_HOST="smtp.tudominio.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notificaciones@tudominio.com"
SMTP_PASS="clave-smtp-aqui"
SMTP_FROM="\"MenuQR Pro\" <notificaciones@tudominio.com>"

# Pasarela de Pagos dLocal (Opcional)
DLOCAL_API_KEY=""
DLOCAL_SECRET_KEY=""
DLOCAL_SMARTFIELDS_API_KEY=""

# Parámetros comerciales
PAYMENT_API_KEY=""
PAYMENT_SECRET_KEY=""
SMARTFIELDS_API_KEY=""
NEXT_PUBLIC_PLAN_PRICE="15"

# Evolution API v2 Configuration (WhatsApp Gateway)
EVOLUTION_API_URL="http://evolution-api:8080"
EVOLUTION_API_KEY="clave-api-evolution-generada"
EVOLUTION_WEBHOOK_SECRET="clave-webhook-secret-evolution"
EVOLUTION_INSTANCE_NAME="menuqr"
EVOLUTION_STRICT_AUTH="false"

# Google Sign-In & OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Alertas Instantáneas a Telegram (Webhook n8n)
N8N_TELEGRAM_WEBHOOK_URL="https://n8n.tudominio.com/webhook/identificador-webhook-secreto"

# Clave Secreta para Endpoints Internos y Automatización con n8n
INTERNAL_API_KEY="clave-secreta-interna-generada-con-openssl"
